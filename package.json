{
  "name": "ruwen-studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "core": "node packages/core/bin/ruwen-core.ts",
    "demo:create": "node scripts/create-demo.ts",
    "benchmark:real": "node scripts/benchmark-real.ts",
    "redteam": "node scripts/redteam.ts",
    "p3:smoke": "node scripts/p3-smoke.ts",
    "db:dev": "node scripts/dev-postgres.ts",
    "db:migrate": "node apps/worker/scripts/migrate.ts",
    "db:backup": "node scripts/db-backup.ts",
    "db:restore": "node scripts/db-restore.ts",
    "test:containers": "node scripts/container-smoke.ts",
    "dev": "node scripts/preview.ts",
    "build:web": "pnpm --filter web build",
    "test:e2e": "pnpm build:web && playwright test",
    "demo:db": "node scripts/demo-db.ts",
    "typecheck": "tsc --noEmit",
    "check:prompt-sources": "node scripts/check-prompt-sources.ts",
    "test": "vitest run",
    "test:fast": "vitest run --config vitest.fast.config.ts",
    "test:upstream": "python -I -B scripts/verify-upstream.py"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "18.6.0-beta.19",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@sentry/node": "11.11.0"
  }
}
